# GEOS-3.4.3
RUN curl -sLo geos-3.4.3.tar.bz2 \
    http://download.osgeo.org/geos/geos-3.4.3.tar.bz2
RUN tar xjf geos-3.4.3.tar.bz2
RUN cd geos-3.4.3 && \
    ./configure --prefix=/opt/geos-3.4.3 \
      --disable-swig \
      --disable-static \
    && make install-strip
RUN cd .. && rm -rf geos-3.4.3*

